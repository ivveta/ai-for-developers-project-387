{
  "ci": {
    "collect": {
      "url": [
        "https://ai-for-developers-project-386-tchb.onrender.com/",
        "https://ai-for-developers-project-386-tchb.onrender.com/book",
        "https://ai-for-developers-project-386-tchb.onrender.com/admin"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 0.7 }],
        "categories:best-practices": ["error", { "minScore": 0.7 }],
        "categories:seo": ["error", { "minScore": 0.6 }]
      }
    },
    "upload": {
      "target": "filesystem"
    }
  }
}
