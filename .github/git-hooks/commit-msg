#!/usr/bin/env bash
# commit-msg hook: добавляет Conventional Commits тип (fix:) если его нет.
# Используется в GitHub Actions чтобы commitlint не отклонял коммиты агента.

msg_file="$1"
first_line=$(head -1 "$msg_file")

if ! echo "$first_line" | grep -qE '^[a-z]+(\(.+\))?:'; then
  sed -i '' "1s/^/fix: /" "$msg_file" 2>/dev/null || sed -i "1s/^/fix: /" "$msg_file"
fi
