# Подключение к БД разработки (сервис postgres в docker-compose.yml, порт 5432)
DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar

# Подключение к тестовой БД (сервис postgres-test, порт 5433) — интеграционные тесты
TEST_DATABASE_URL=postgres://calendar:calendar@localhost:5433/calendar_test

# Порт HTTP-сервера бэкенда
PORT=3000
